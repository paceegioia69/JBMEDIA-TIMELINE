.node { position: relative; display: flex; flex-direction: column; align-items: center; margin-right: 80px; cursor: pointer; width: 140px; }
.node:last-child { margin-right: 0; }
.node-dot { width: 10px; height: 10px; border-radius: 50%; background: #555; border: 2px solid #080808; position: relative; z-index: 1; transition: background 0.3s ease, transform 0.3s ease; flex-shrink: 0; }
.node.active .node-dot { background: #e8d0a8; transform: scale(1.4); }
.node-year { font-size: 10px; font-weight: 500; letter-spacing: 0.22em; color: #888; margin-top: 14px; transition: color 0.3s ease; }
