.node-title { font-size: 11px; font-weight: 400; letter-spacing: 0.06em; color: #ffffff; margin-top: 8px; text-align: center; line-height: 1.5; }
.node:hover .node-dot { background: #999; }
.node:hover .node-year { color: #cccccc; }

.panel-spacer { height: 0; transition: height 0.38s cubic-bezier(0.22, 1, 0.36, 1); }
.panel-spacer.active { height: 52vh; }

.panel { position: fixed; bottom: 0; left: 0; right: 0; background: #0d0d0d; border-top: 1px solid #222; padding: 36px 48px 44px; transform: translateY(100%); transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1); z-index: 100; max-height: 52vh; overflow-y: auto; }
.panel.open { transform: translateY(0); }
.panel-inner { display: grid; grid-template-columns: 80px 1fr; gap: 0 48px; max-width: 780px; margin: 0 auto; }
.panel-year { font-size: 10px; font-weight: 500; letter-spacing: 0.3em; text-transform: uppercase; color: #e8d0a8; padding-top: 6px; }
.panel-content { display: flex; flex-direction: column; }
.panel-title { font-size: 22px; font-weight: 400; letter-spacing: 0.02em; color: #ffffff; margin-bottom: 6px; }
.panel-tagline { font-size: 13px; font-weight: 300; font-style: italic; color: #888; letter-spacing: 0.04em; margin-bottom: 20px; }
.panel-body-wrap { flex: 1; }
.panel-text { font-size: 16px; font-weight: 300; line-height: 1.95; color: #ffffff; margin-bottom: 0; max-width: 600px; }
.panel-close-text { font-size: 14px; font-weight: 400; font-style: italic; color: #e8d0a8; line-height: 1.7; max-width: 600px; margin-top: 20px; padding-top: 16px; border-top: 1px solid #222; }
.panel-dismiss { position: absolute; top: 28px; right: 44px; font-size: 9px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: #444; cursor: pointer; transition: color 0.3s ease; background: none; border: none; padding: 4px; }
.panel-dismiss:hover { color: #e8d0a8; }

.close-section { max-width: 780px; margin: 0 auto; padding: 72px 48px 110px; border-top: 1px solid #1a1a1a; }
.close-inner { padding-left: 48px; border-left: 1px solid #333; margin-bottom: 64px; }
.close-line { font-size: 16px; font-weight: 300; letter-spacing: 0.01em; line-height: 2.1; color: #ffffff; }
.close-line + .close-line { margin-top: 4px; }
.close-gap { margin-top: 32px; }
.close-sig { font-size: 10px; font-weight: 500; letter-spacing: 0.36em; text-transform: uppercase; color: #e8d0a8; text-align: center; line-height: 2.8; }

@media (max-width: 640px) {
.opening { padding: 60px 28px 50px; }
.opening-border { padding-left: 20px; }
.since { padding-left: 20px; }
.panel { padding: 36px 28px 44px; }
.panel-inner { grid-template-columns: 1fr; gap: 16px; }
.panel-year { padding-top: 0; }
.close-section { padding: 52px 28px 80px; }
.close-inner { padding-left: 24px; }
.panel-dismiss { right: 24px; top: 20px; }
}
