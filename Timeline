<script>
let current = null;

function open_panel(node, year, title, tagline, body, gravel) {
  if (current && current !== node) {
    current.classList.remove('active');
  }
  if (current === node) {
    close_panel();
    return;
  }
  current = node;
  node.classList.add('active');
  document.getElementById('panel-year').textContent = year;
  document.getElementById('panel-title').textContent = title;
  document.getElementById('panel-tagline').textContent = tagline;
  document.getElementById('panel-text').textContent = body;
  document.getElementById('panel-close').textContent = gravel;
  document.getElementById('panel').classList.add('open');
  document.getElementById('spacer').classList.add('active');
}

function close_panel() {
  document.getElementById('panel').classList.remove('open');
  document.getElementById('spacer').classList.remove('active');
  if (current) {
    current.classList.remove('active');
    current = null;
  }
}
</script>

